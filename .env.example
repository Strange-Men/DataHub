# ==================================================
# DataHub local Docker Compose environment template.
# Copy to .env, replace local-only passwords, and never commit .env.
# Scope: compose.yaml only. DATAHUB_ENV is fixed to local in Compose; staging
# and production deployments must define their own fail-closed environment.
# Secret fields remain empty. Logs and public status endpoints may report only
# whether a secret is configured, never its value.
# ==================================================

# --------------------------------------------------
# Docker Compose image, ports, CORS, and PostgreSQL (local only)
# --------------------------------------------------
DATAHUB_IMAGE_TAG=local
POSTGRES_DB=datahub
POSTGRES_USER=datahub
# Required. Keep the template empty so Compose fails closed until .env supplies it.
# URL-reserved characters are supported by the backend entrypoint's encoding;
# when needed, quote/escape values according to Docker Compose dotenv rules.
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
# Optional override. When omitted, Compose derives localhost/127.0.0.1 origins
# from FRONTEND_PORT and keeps the current public frontend origin.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://data-hub-flame.vercel.app

# DATAHUB_ENV is intentionally not configurable through this template:
# compose.yaml injects DATAHUB_ENV=local into db-init and backend.
# RENDER is a platform-managed compatibility marker, not a local setting. When
# a hosted platform supplies RENDER=true, local/test labels are treated as
# deployed authority and production Auth safety remains fail-closed.

# --------------------------------------------------
# Governance authentication and RBAC (all environments)
# Local Compose defaults to disabled. Any service exposed beyond a trusted
# workstation must use token; staging/production reject disabled mode.
# Empty role tokens make only that role unavailable; token mode requires at
# least one role and rejects duplicate values. Never commit the real values.
# --------------------------------------------------
DATAHUB_AUTH_MODE=disabled
DATAHUB_ADMIN_TOKEN=
DATAHUB_CLEANER_TOKEN=
DATAHUB_REVIEWER_TOKEN=
DATAHUB_SERVICE_TOKEN=
DATAHUB_VIEWER_TOKEN=

# --------------------------------------------------
# No-answer calibration and abstention gate (backend, all environments)
# disabled: calculate metadata only and preserve legacy results.
# shadow: record decisions without suppressing Agent evidence.
# enforced: CustomerOpsAgent abstains when evidence is not reliable.
# Raw P1/P2/Unified retrieval always keeps candidates for diagnostics.
# Thresholds are calibrated per score semantics; Unified uses a normalized
# source-local threshold ratio and never compares raw P1/P2/RRF scores.
# --------------------------------------------------
DATAHUB_NO_ANSWER_MODE=disabled
P1_NO_ANSWER_MIN_SCORE=0.45
P2_NO_ANSWER_MIN_SCORE=0.55
UNIFIED_NO_ANSWER_MIN_SCORE=1.0
NO_ANSWER_MIN_EVIDENCE=1
NO_ANSWER_AMBIGUOUS_QUERY_MIN_LENGTH=4

# Compose assembles the container DATABASE_URL from POSTGRES_* variables and
# never logs it. The one-shot db-init service runs the Alembic upgrade before
# backend startup. DATABASE_URL below applies only to direct non-Compose usage.
# DATABASE_URL=postgresql://datahub:<url-encoded-password>@127.0.0.1:5433/datahub

# --------------------------------------------------
# P2 Asset Storage (backend, local Compose)
# Compose mounts a named volume and supplies the container root. For non-Docker
# development, set an absolute ASSET_STORAGE_ROOT only in the ignored .env file.
# --------------------------------------------------
ASSET_STORAGE_BACKEND=local
ASSET_MAX_UPLOAD_BYTES=10485760
# Compose fixes ASSET_STORAGE_ROOT=/data/assets inside the named volume. A host
# ASSET_STORAGE_ROOT value is intentionally ignored by the local Compose stack.

# --------------------------------------------------
# Deprecated/inert generic LLM compatibility keys
# The current backend does not consume LLM_*; P3 uses P3_LLM_* below. These
# examples are retained only to identify old .env entries and must not be used
# as evidence that an LLM provider is active.
# --------------------------------------------------
# LLM_PROVIDER=deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=

# P3 governed LLM draft generation (backend, all environments) is explicit
# opt-in and disabled by default. P3_LLM_API_KEY is a runtime secret.
P3_LLM_DRAFT_ENABLED=false
P3_LLM_PROVIDER_PROFILE=openai_compatible
P3_LLM_BASE_URL=
P3_LLM_MODEL=
P3_LLM_API_KEY=
P3_LLM_MAX_SOURCE_COUNT=100
P3_LLM_MAX_CONTEXT_CHARS=80000
P3_LLM_MAX_OUTPUT_CHARS=200000
P3_LLM_MAX_OUTPUT_TOKENS=4096
P3_LLM_TIMEOUT_SECONDS=120

# P3 governed export files (backend). Local Compose defaults to a named volume;
# this does not establish persistent storage for a deployed environment.
P3_EXPORT_STORAGE_BACKEND=local_filesystem
P3_EXPORT_STORAGE_ROOT=

# --------------------------------------------------
# Embedding Provider (backend, all environments)
# P1 and the P2 text bridge currently require 1536 dimensions. Mock is the safe
# keyless startup default, but it is not real semantic-release evidence.
# --------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-deterministic
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
# Leave empty in mock mode. The application derives the immutable P2 profile.
P2_EMBEDDING_PROFILE=
# Existing P2 retrieval cutoff. This documents the frozen default only; changing
# it requires a separately reviewed retrieval rollout.
P2_RETRIEVAL_MIN_SCORE=0.45

# Direct non-Compose compatibility only: embedding.py also recognizes the
# legacy OPENAI_API_KEY / OPENAI_BASE_URL aliases when the corresponding
# EMBEDDING_* value is empty. Local Compose deliberately does not forward these
# ambiguous aliases; prefer the explicit EMBEDDING_* contract above.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --------------------------------------------------
# P2-M8.2 Unified Retrieval Shadow Gate (backend, all environments)
# All switches fail closed. Enabling the versioned API does not change the
# sealed P1 endpoint or the CustomerOpsAgent default retrieval path.
# --------------------------------------------------
UNIFIED_RETRIEVAL_ENABLED=false
P2_RETRIEVAL_ENABLED=false
UNIFIED_RETRIEVAL_SHADOW_MODE=false
# Independent Agent kill switch. Active Unified evidence requires this flag,
# both retrieval flags above, an explicit v2 request opt-in, and Shadow off.
CUSTOMEROPS_UNIFIED_RETRIEVAL_ENABLED=false
UNIFIED_RETRIEVAL_BRANCH_TIMEOUT_SECONDS=8
UNIFIED_RETRIEVAL_RRF_K=60
UNIFIED_RETRIEVAL_P2_ASSET_CHUNK_QUOTA=2

# --------------------------------------------------
# Real SiliconFlow acceptance profile (explicit local acceptance only)
# Uncomment in the local .env and supply the secret only at runtime.
# --------------------------------------------------
# EMBEDDING_PROVIDER=siliconflow
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# EMBEDDING_DIMENSION=1536
# P2_EMBEDDING_PROFILE=text_bridge:siliconflow:Qwen/Qwen3-Embedding-4B:1536

# --------------------------------------------------
# Jina requires a separately reviewed 1536-dimension compatibility plan.
# Do not point a 2048-dimensional model at the current Vector(1536) tables.
# --------------------------------------------------
# EMBEDDING_PROVIDER=jina
# EMBEDDING_BASE_URL=https://api.jina.ai/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=jina-embeddings-v4
# EMBEDDING_DIMENSION=1536

# --------------------------------------------------
# Inert compatibility settings
# LOG_LEVEL and DEBUG are not consumed by the current backend runtime. They are
# retained for old local .env compatibility; Uvicorn flags control these modes.
# --------------------------------------------------
LOG_LEVEL=info
DEBUG=false
